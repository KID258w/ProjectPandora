# 服务器端 /opt/pandora/.env 模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，禁止提交。
# 生成密钥：
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# ===== Django =====
DJANGO_SECRET_KEY=
# 必须固定不变：改动后已加密的身份证号无法解密
IDENTITY_NUMBER_ENCRYPTION_KEY=
DJANGO_DEBUG=False
# 填域名；还没域名就先填服务器公网 IP，用 IP 访问时也要包含 127.0.0.1
DJANGO_ALLOWED_HOSTS=pandora.example.com,127.0.0.1,localhost
# 用 https 访问 Django Admin 时必须配置，否则 CSRF 校验失败
DJANGO_CSRF_TRUSTED_ORIGINS=https://pandora.example.com
CORS_ALLOWED_ORIGINS=https://pandora.example.com

# ===== 运行数据（对应 compose 里的 pandora-data 卷）=====
SQLITE_PATH=/data/db.sqlite3
DJANGO_MEDIA_ROOT=/data/media
DJANGO_STATIC_ROOT=/srv/static
PANDORA_DATA_DIR=/data

# ===== 进程与端口 =====
GUNICORN_WORKERS=3
# Web 对外端口；被 Nginx/Caddy 反代时改成 127.0.0.1 上未被占用的端口
WEB_PORT=80

# ===== 镜像（一般不用改，自动部署会覆盖）=====
BACKEND_IMAGE=ghcr.io/kid258w/projectpandora/backend
WEB_IMAGE=ghcr.io/kid258w/projectpandora/web
IMAGE_TAG=latest
