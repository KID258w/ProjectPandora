DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=True
# Generate a private key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Share it across backend instances in one deployment, back it up securely, and never commit the production key.
IDENTITY_NUMBER_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 反向代理 + HTTPS 部署时填公网来源（如 https://pandora.example.com），否则 Admin 的 CSRF 校验会 403
DJANGO_CSRF_TRUSTED_ORIGINS=
SQLITE_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 仅容器部署需要：collectstatic 产物与附件在宿主机/卷上的位置
# DJANGO_STATIC_ROOT=/srv/static
# DJANGO_MEDIA_ROOT=/data/media
# 公司重要事项附件限制（可选，留空使用代码默认值：10 MB 与 PDF/图片/文本/Office 白名单）
# COMPANY_ITEM_ATTACHMENT_MAX_BYTES=10485760
# COMPANY_ITEM_ATTACHMENT_MIME_TYPES=application/pdf,image/png,image/jpeg
